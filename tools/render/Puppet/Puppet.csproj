<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Trade steps only build against commits whose server has trading (claims-7). -->
  <PropertyGroup Condition="Exists('../../../client/module_bindings/Reducers/AskTrade.g.cs')">
    <DefineConstants>$(DefineConstants);HAS_TRADE</DefineConstants>
  </PropertyGroup>
  <!-- Later commits let a player take an accept back: AcceptTrade(id, version, accept). -->
  <PropertyGroup Condition="Exists('../../../client/module_bindings/Reducers/AcceptTrade.g.cs') And $([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../../client/module_bindings/Reducers/AcceptTrade.g.cs').Contains('bool accept'))">
    <DefineConstants>$(DefineConstants);TRADE_UNACCEPT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.12.*" />
    <Compile Include="../../../client/module_bindings/**/*.cs" LinkBase="Bindings" />
  </ItemGroup>

</Project>
